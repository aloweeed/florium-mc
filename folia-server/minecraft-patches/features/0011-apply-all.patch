new file mode 100644
index 0000000000000000000000000000000000000000..4fb6b2d6c6a61d81484250d91a108cce2df7f244
--- /dev/null
+++ b/dev/florium/FloriumEntityScheduler.java
@@ -0,0 +1,173 @@
+package dev.florium;
+
+import ca.spottedleaf.moonrise.common.list.IteratorSafeOrderedReferenceSet;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.profiling.ProfilerFiller;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.decoration.ArmorStand;
+import net.minecraft.world.entity.item.FallingBlockEntity;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.LevelChunk;
+
+public final class FloriumEntityScheduler {
+
+    // Florium start - hard optimize lag entities
+
+    private static final int CHUNK_THRESHOLD = 40;
+
+    private static final int TARGET_TICKS_PER_CHUNK = 200;
+
+    private static final int MAX_INTERVAL = 20;
+
+    private final ServerLevel level;
+
+    public FloriumEntityScheduler(final ServerLevel level) {
+        this.level = level;
+    }
+
+    public void tick(
+            final IteratorSafeOrderedReferenceSet.Iterator<Entity> iterator,
+            final ProfilerFiller profiler
+    ) {
+        try {
+            final long gameTime = this.level.getGameTime();
+
+            while (iterator.hasNext()) {
+                final Entity entity = iterator.next();
+
+                if (!shouldTick(entity, gameTime)) {
+                    handleSkippedTick(entity);
+                    continue;
+                }
+
+                beforeRealTick(entity);
+                tickEntity(entity, profiler);
+            }
+        } finally {
+            iterator.finishedIterating();
+        }
+    }
+
+    private boolean shouldTick(
+            final Entity entity,
+            final long gameTime
+    ) {
+        if (!isLagEntity(entity)) {
+            return true;
+        }
+
+        if (entity.isRemoved()) {
+            return false;
+        }
+
+        final ChunkPos pos = entity.chunkPosition();
+
+        final LevelChunk chunk =
+                this.level.getChunkSource().getChunkNow(pos.x(), pos.z());
+
+        if (chunk == null) {
+            return true;
+        }
+
+        final int count = chunk.florium$lagEntities;
+
+        final int CHUNK_THRESHOLD = (entity instanceof ArmorStand) ? 15 : 40;
+        final int TARGET_TICKS_PER_CHUNK = (entity instanceof ArmorStand) ? 15 : 80;
+        final int MAX_INTERVAL = (entity instanceof ArmorStand) ? 40 : 20;
+
+        if (count <= CHUNK_THRESHOLD) {
+            return true;
+        }
+        final int interval = Math.clamp(
+                ceilDiv(count, TARGET_TICKS_PER_CHUNK),
+                1,
+                MAX_INTERVAL
+        );
+
+        if (interval == 1) {
+            return true;
+        }
+
+        final int entityPhase =
+                Math.floorMod(entity.getId(), interval);
+
+        final int currentPhase =
+                Math.floorMod(gameTime, interval);
+
+        return entityPhase == currentPhase;
+    }
+
+    private static void handleSkippedTick(final Entity entity) {
+        if (entity instanceof FallingBlockEntity fallingBlock) {
+            ++fallingBlock.florium$skippedTicks;
+        }
+    }
+
+    private static void beforeRealTick(final Entity entity) {
+        if (entity instanceof FallingBlockEntity fallingBlock) {
+            final int skipped = fallingBlock.florium$skippedTicks;
+
+            if (skipped != 0) {
+                fallingBlock.time += skipped;
+                fallingBlock.florium$skippedTicks = 0;
+            }
+        }
+    }
+
+    public static boolean isLagEntity(final Entity entity) {
+        return entity instanceof ArmorStand
+                || entity instanceof FallingBlockEntity;
+    }
+
+    private static int ceilDiv(
+            final int value,
+            final int divisor
+    ) {
+        return (value + divisor - 1) / divisor;
+    }
+
+    private void tickEntity(
+            final Entity entity,
+            final ProfilerFiller profiler
+    ) {
+        if (entity.isRemoved()) {
+            return;
+        }
+
+        if (this.level.tickRateManager().isEntityFrozen(entity)) {
+            return;
+        }
+
+        profiler.push("checkDespawn");
+        entity.checkDespawn();
+        profiler.pop();
+
+//        if (entity instanceof ArmorStand) return;
+
+        // Folia - region threading
+        if (entity.isRemoved()) {
+            return;
+        }
+
+        final Entity vehicle = entity.getVehicle();
+
+        if (vehicle != null) {
+            if (!vehicle.isRemoved() && vehicle.hasPassenger(entity)) {
+                return;
+            }
+
+            entity.stopRiding();
+        }
+
+        profiler.push("tick");
+
+        this.level.guardEntityTick(
+                this.level::tickNonPassenger,
+                entity
+        );
+
+        profiler.pop();
+    }
+
+    // Florium end - hard optimize lag entities
+}
