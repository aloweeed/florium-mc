diff --git a/dev/florium/FloriumUtil.java b/dev/florium/FloriumUtil.java
new file mode 100644
index 0000000000000000000000000000000000000000..383df299512ea015117544aba6a1f03b76e3d103
--- /dev/null
+++ b/dev/florium/FloriumUtil.java
@@ -0,0 +1,117 @@
+package dev.florium;
+
+import ca.spottedleaf.common.time.TickData;
+import io.papermc.paper.adventure.PaperAdventure;
+import io.papermc.paper.threadedregions.ThreadedRegionizer;
+import io.papermc.paper.threadedregions.TickRegionScheduler;
+import io.papermc.paper.threadedregions.TickRegions;
+import io.papermc.paper.threadedregions.scheduler.FoliaAsyncScheduler;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.ComponentLike;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.minimessage.MiniMessage;
+import net.kyori.adventure.text.minimessage.tag.resolver.TagResolver;
+import net.kyori.adventure.text.minimessage.tag.standard.StandardTags;
+import net.minecraft.network.chat.TextColor;
+import net.minecraft.network.protocol.game.ClientboundBossEventPacket;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.bossevents.CustomBossEvent;
+import net.minecraft.server.level.ServerPlayer;
+import org.bukkit.Bukkit;
+import org.bukkit.boss.BossBar;
+import org.bukkit.craftbukkit.boss.CraftKeyedBossbar;
+import org.bukkit.craftbukkit.entity.CraftPlayer;
+import org.bukkit.entity.Player;
+
+import java.awt.*;
+import java.text.DecimalFormat;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executor;
+import java.util.concurrent.Executors;
+
+public class FloriumUtil {
+    public static final MiniMessage MM = MiniMessage.miniMessage();
+    public static final String GRADIENT_TEMPLATE = "<gradient:#8EF56A:#37D67A:#00C2A8>";
+    public static final net.kyori.adventure.text.format.TextColor COLOR_A = net.kyori.adventure.text.format.TextColor.color(0xFF2222);
+    public static final net.kyori.adventure.text.format.TextColor COLOR_B = net.kyori.adventure.text.format.TextColor.color(0xAAFFAA);
+    public static final Component FLORIUM_COLORED = formatGradient("Florium");
+
+    private static long LAST_UPDATE = 0;
+    private static final long INTERVAL = 2000; // 2 sec.
+    private static final CustomBossEvent BAR = new CustomBossEvent(UUID.randomUUID(), Identifier.withDefaultNamespace("florium-bossbar"), net.minecraft.network.chat.Component.literal("test"), () -> {});
+
+    private static final Executor ASYNC = Executors.newSingleThreadScheduledExecutor();
+    private static final ThreadLocal<DecimalFormat> TWO_DECIMAL_PLACES = ThreadLocal.withInitial(() -> {
+        return new DecimalFormat("#,##0.00");
+    });
+
+    private static final Set<ServerPlayer> STAT_LISTENERS = ConcurrentHashMap.newKeySet();
+    public static boolean toggleStatListener(Player player) {
+        ServerPlayer serverPlayer = ((CraftPlayer) player).getHandle();
+        if (STAT_LISTENERS.contains(serverPlayer)) {
+            serverPlayer.connection.send(ClientboundBossEventPacket.createRemovePacket(BAR.getId()));
+            STAT_LISTENERS.remove(serverPlayer);
+            return false;
+        } else {
+            serverPlayer.connection.send(ClientboundBossEventPacket.createAddPacket(BAR));
+            STAT_LISTENERS.add(serverPlayer);
+            return true;
+        }
+    }
+    public static void updateStat() {
+        if (System.currentTimeMillis() - LAST_UPDATE > INTERVAL) {
+            final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region =
+                    TickRegionScheduler.getCurrentRegion();
+            final long currTime = System.nanoTime();
+
+            final TickData.TickReportData report15s = region.getData().getRegionSchedulingHandle().getTickReport15s(currTime);
+            final double tps15s = report15s.tpsData().segmentAll().average();
+            final double mspt15s = report15s.timePerTickData().segmentAll().average() / 1.0E6;
+
+            final double tps_factor = tps15s / 20f;
+            final double mspt_factor = 1f - (mspt15s / 100f);
+            Runtime runtime = Runtime.getRuntime();
+            final long used = (runtime.maxMemory() - runtime.freeMemory());
+            final double mb = 1024.0 * 1024.0 * 1024.0;
+            final double ram = used / mb;
+
+            Component format = Component.text("TPS: ").color(NamedTextColor.GRAY)
+                    .append(transition(TWO_DECIMAL_PLACES.get().format(tps15s), tps_factor))
+                    .append(Component.text(" MSPT: ").color(NamedTextColor.GRAY))
+                    .append(transition(TWO_DECIMAL_PLACES.get().format(mspt15s), mspt_factor))
+                    .append(Component.text(" RAM: ").color(NamedTextColor.GRAY))
+                    .append(transition(TWO_DECIMAL_PLACES.get().format(ram), 1f - ((double) used / runtime.maxMemory())))
+                    .append(Component.text("/").color(NamedTextColor.GRAY))
+                    .append(transition(TWO_DECIMAL_PLACES.get().format(runtime.maxMemory() / mb), 1f));
+            BAR.setName(PaperAdventure.asVanilla(format));
+            BAR.setProgress((float) (tps_factor * mspt_factor));
+            LAST_UPDATE = System.currentTimeMillis();
+            ClientboundBossEventPacket updateName = ClientboundBossEventPacket.createUpdateNamePacket(BAR);
+            ClientboundBossEventPacket updateProgress = ClientboundBossEventPacket.createUpdateProgressPacket(BAR);
+            for (ServerPlayer player : STAT_LISTENERS) {
+                player.connection.send(updateName);
+                player.connection.send(updateProgress);
+            }
+        }
+    }
+
+    public static Component formatGradient(String m) {
+        return MM.deserialize(GRADIENT_TEMPLATE.concat(m).concat("</gradient>"));
+    }
+    public static String formatGradientString(String m) {
+        return GRADIENT_TEMPLATE.concat(m).concat("</gradient>");
+    }
+    public static Component transition(String m, double state) {
+        return Component.text(m).color(net.kyori.adventure.text.format.TextColor.lerp((float) Math.clamp(state, 0f, 1f), COLOR_A, COLOR_B));
+    }
+
+    public static ComponentLike getVersion() {
+        return FLORIUM_COLORED.append(MM.deserialize(" running on <gray>".concat(Bukkit.getVersion())));
+    }
+
+    public static void runAsync(Runnable task) {
+        ASYNC.execute(task);
+    }
+}
