diff --git a/dev/florium/FloriumExplosionScheduler.java b/dev/florium/FloriumExplosionScheduler.java
new file mode 100644
index 0000000000000000000000000000000000000000..43f6432b209ea21f98fa1b1c165dcb3f4ff0daf8
--- /dev/null
+++ b/dev/florium/FloriumExplosionScheduler.java
@@ -0,0 +1,116 @@
+package dev.florium;
+
+import io.papermc.paper.threadedregions.scheduler.FoliaAsyncScheduler;
+import net.minecraft.core.particles.ParticleOptions;
+import net.minecraft.network.protocol.game.ClientboundExplodePacket;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.util.Mth;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.ServerExplosion;
+import net.minecraft.world.level.chunk.ChunkAccess;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.phys.Vec3;
+
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+
+public class FloriumExplosionScheduler {
+    ServerLevel level;
+    final Map<Vec3, ArrayList<ServerExplosion>> regions = new HashMap<>();
+    private final Executor executors = new ThreadPoolExecutor(Math.max(4, Runtime.getRuntime().availableProcessors() / 2), Integer.MAX_VALUE,
+            30L, TimeUnit.SECONDS, new SynchronousQueue<>(),
+            new ThreadFactory() {
+                private final AtomicInteger idGenerator = new AtomicInteger();
+
+                @Override
+                public Thread newThread(final Runnable run) {
+                    final Thread ret = new Thread(run);
+
+                    ret.setName("Florium Async Scheduler Thread #" + this.idGenerator.getAndIncrement());
+                    ret.setPriority(Thread.NORM_PRIORITY - 1);
+//                    ret.setUncaughtExceptionHandler((final Thread thread, final Throwable thr) -> {
+//                        LOGGER.error("Uncaught exception in thread: " + thread.getName(), thr);
+//                    });
+
+                    return ret;
+                }
+            }
+    );
+    public FloriumExplosionScheduler(ServerLevel level) {
+        this.level = level;
+    }
+
+    public void schedule(ServerExplosion e) {
+        FloriumScheduler.run(() -> {
+            synchronized (this.regions) {
+                Vec3 closest = null;
+                double closestDistance = 16384.0;
+
+                Vec3 center = e.center();
+
+                for (Vec3 region : regions.keySet()) {
+                    double dx = region.x - center.x;
+                    double dz = region.z - center.z;
+                    double distance = dx * dx + dz * dz;
+
+                    if (distance <= 16384.0 && distance < closestDistance) {
+                        closest = region;
+                        closestDistance = distance;
+                    }
+                }
+
+                if (closest == null) {
+                    closest = center;
+                }
+
+                regions.computeIfAbsent(closest, k -> new ArrayList<>()).add(e);
+            }
+        });
+    }
+    public void tick() {
+//        synchronized (this.regions) {
+        if (regions.isEmpty()) return;
+        Iterator<ArrayList<ServerExplosion>> it = regions.values().iterator();
+//        int ticked = 0;
+        while (it.hasNext()) {
+            ArrayList<ServerExplosion> region = it.next();
+//                Collections.shuffle(region);
+            if (region.isEmpty()) {
+                it.remove();
+                continue;
+            }
+//            ticked += region.size();
+            for (int i = 0; i < 8; i++) {
+                if (region.isEmpty()) break;
+                ServerExplosion explosion = region.removeFirst();
+                List<ServerPlayer> receivers = level.getLocalPlayers();
+                int blockCount = explosion.explode();
+                FloriumScheduler.run(() -> {
+                    ParticleOptions explosionParticle = explosion.florium$explosionParticles;
+                    for (ServerPlayer player : receivers) {
+
+                        if (player.distanceToSqr(explosion.center()) < 4096.0) {
+                            Optional<Vec3> playerKnockback =
+                                    Optional.ofNullable(explosion.getHitPlayers().get(player));
+
+                            player.connection.send(new ClientboundExplodePacket(
+                                    explosion.center(),
+                                    explosion.radius(),
+                                    blockCount,
+                                    playerKnockback,
+                                    explosionParticle,
+                                    explosion.florium$sound,
+                                    explosion.florium$blockParticles
+                            ));
+                        }
+                    }
+                });
+            }
+        }
+//            System.out.println("ticked " + ticked);
+//        }
+    }
+}
